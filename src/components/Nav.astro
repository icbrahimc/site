---
const links = [
  { label: 'iconteh', href: '/' },
  { label: 'works', href: '/works' },
  { label: 'music', href: 'https://eyeconteh.xyz', external: true },
];
---

<nav class="fixed top-6 left-1/2 -translate-x-1/2 z-50 flex gap-6 rounded-full border border-foreground/10 bg-background/80 px-5 py-2 backdrop-blur">
  {links.map((link) => (
    <a
      href={link.href}
      class="font-bold underline"
      target={link.external ? '_blank' : undefined}
      rel={link.external ? 'noopener noreferrer' : undefined}
    >
      {link.label}
    </a>
  ))}
</nav>
