---
interface Props {
  src: string;
  label: string;
}

const { src, label } = Astro.props;
const isImage = /\.(png|jpe?g|webp)$/i.test(src);
---

<button
  type="button"
  class="media-trigger inline-flex align-middle ml-1.5 cursor-pointer text-foreground/50 hover:text-foreground"
  data-media={src}
  data-caption={label}
  aria-label={`View ${label}`}
  title={label}
>
  {isImage ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
      <circle cx="8.5" cy="8.5" r="1.5"></circle>
      <path d="M21 15l-5-5L5 21"></path>
    </svg>
  ) : (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
      <rect x="2" y="6" width="14" height="12" rx="2"></rect>
      <path d="M16 10l6-3v10l-6-3"></path>
    </svg>
  )}
</button>
