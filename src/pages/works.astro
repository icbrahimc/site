type Media = { src: string; label: string };

// Flattens every screenshot/video attached to a role's projects (and their
// sub-items) into one list for the Media column.
function collectMedia(projects: any[] | undefined): Media[] {
  const out: Media[] = [];
  const walk = (item: any) => {
    if (!item || typeof item === 'string') return;
    if (item.video) out.push({ src: item.video, label: item.videoLabel ?? item.text });
    (item.videos ?? []).forEach((v: Media) => out.push(v));
    (item.subitems ?? []).forEach(walk);
  };
  (projects ?? []).forEach(walk);
  return out;
}

const sections = [
  { title: 'Experience', companies: experience },
  { title: 'Internships', companies: internships },
  { title: 'Personal Projects', companies: personalProjects },
];
---

<Layout title="Works | I Conteh" description="I Conteh. Works." current="works">
  <main class="flex flex-col gap-24 px-5 md:gap-[200px] md:px-[50px]">
    <div class="flex flex-col gap-6 pt-[120px] md:gap-8 md:pt-[130px]">
      <h1 class="title">Works</h1>
      <p class="flex flex-wrap items-center text-[16px] font-normal uppercase md:text-[24px]">
        <a class="link-row no-underline" href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a><span aria-hidden="true" class="mr-3">,</span>
        <a class="link-row no-underline" href="https://www.linkedin.com/in/ibrahim-conteh-42a518b2/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </p>
    </div>

    {sections.map((section) => (
      <section aria-labelledby={`${section.title}-heading`} class="flex flex-col gap-14">
        <h2 id={`${section.title}-heading`} class="label">{section.title}</h2>
        {section.companies.map((company) =>
          company.roles.map((role: any) => {
            const media = collectMedia(role.projects);
            return (
              <article class="mb-14 grid grid-cols-12 gap-x-5 gap-y-4 last:mb-0">
                <p class="label col-span-12 flex items-baseline gap-2 md:col-span-2">
                  {role.period === 'Present' && <span aria-hidden="true" class="inline-block size-2 bg-accent" />}
                  {role.period}
                </p>
                <div class="col-span-12 flex flex-col gap-3.5 md:col-span-5">
                  <h3 class="font-medium uppercase">
                    {company.link ? (
                      <a class="underline underline-offset-4" href={company.link} target="_blank" rel="noopener noreferrer">{company.org}</a>
                    ) : company.org}, {role.link ? (
                      <a class="underline underline-offset-4" href={role.link} target="_blank" rel="noopener noreferrer">{role.role}</a>
                    ) : role.role}
                  </h3>
                  <p class="body-copy">{role.description}</p>
                  {role.projects && (
                    <ul class="flex list-['–_'] flex-col gap-3 pl-[22px] body-copy">
                      {role.projects.map((project: any) => (
                        <li>
                          {typeof project === 'string' ? (
                            project
                          ) : project.link ? (
                            <a class="underline underline-offset-[3px]" href={project.link} target="_blank" rel="noopener noreferrer">{project.text}</a>
                          ) : (
                            project.text
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                {media.length > 0 && (
                  <div class="col-span-12 mt-2 flex flex-col gap-1 md:col-span-4 md:col-start-9 md:mt-0">
                    <p class="label">Media</p>
                    <div class="flex flex-wrap items-center gap-x-1">
                      {media.map((m, i) => (
                        <button
                          type="button"
                          class="media-trigger link-row cursor-pointer px-1 text-left uppercase underline underline-offset-4"
                          data-media={m.src}
                          data-caption={m.label}
                        >
                          {m.label}{i < media.length - 1 ? ',' : ''}
                        </button>
                      ))}
                    </div>
                  </div>
                )}
              </article>
            );
          })
        )}
      </section>
    ))}

    <Footer />
  </main>

  <div
    id="video-lightbox"
    class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 p-6"
  >
    <button
      type="button"
      id="video-lightbox-close"
      class="absolute top-6 right-6 text-white/80 hover:text-white text-3xl leading-none cursor-pointer"
      aria-label="Close"
    >
      &times;
    </button>
    <div class="flex flex-col items-center gap-2 max-h-[85vh] max-w-[90vw]">
      <img id="video-lightbox-img" src="" alt="" class="max-h-[78vh] max-w-[90vw] rounded-lg" />
      <p id="video-lightbox-caption" class="text-white/90 text-sm"></p>
    </div>
  </div>

  <script>
    const lightbox = document.getElementById('video-lightbox');
    const lightboxImg = document.getElementById('video-lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('video-lightbox-caption');
    const closeBtn = document.getElementById('video-lightbox-close');

    function openLightbox(src: string, caption: string) {
      if (!lightbox || !lightboxImg || !lightboxCaption) return;
      lightboxImg.src = src;
      lightboxImg.alt = caption;
      lightboxCaption.textContent = caption;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
    }

    function closeLightbox() {
      if (!lightbox || !lightboxImg || !lightboxCaption) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightboxImg.src = '';
      lightboxCaption.textContent = '';
    }

    document.querySelectorAll('.media-trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const src = trigger.getAttribute('data-media');
        const caption = trigger.getAttribute('data-caption') || '';
        if (src) openLightbox(src, caption);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</Layout>
