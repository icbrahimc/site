    org: 'Looklive',
    link: null,
    icon: null,
    roles: [
      {
        role: 'Junior iOS Developer',
        period: 'Jan 2017 – Jan 2018',
        description:
          'Built login and user tagging, integrated Swift 3, and improved UI across onboarding, product, and discovery.',
      },
    ],
  },
  {
    org: 'YouTube',
    link: null,
    icon: '/icons/youtube.svg',
    roles: [
      {
        role: 'Software Engineering Intern',
        period: 'May 2017 – Aug 2017',
        description: 'iOS developer (front-end) on YouTube Music.',
        projects: [
