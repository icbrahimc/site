---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { portfolio } from '../../data/portfolio';
---

<Layout title="Portfolio | I Conteh" description="I Conteh. Portfolio." current="portfolio">
  <main class="flex flex-col gap-20 px-5 md:gap-[140px] md:px-[50px]">
    <div class="flex flex-col gap-6 pt-[120px] md:pt-[130px]">
      <h1 class="title">Portfolio</h1>
      <p class="max-w-[560px] body-copy">Five projects, from YouTube Music search to the Audioshake API.</p>
    </div>

    <section aria-label="Portfolio entries" class="flex flex-col gap-16 md:gap-24">
      {portfolio.map((entry) => (
        <article class="grid grid-cols-12 gap-x-5 items-start">
          <p class="label col-span-12 mb-3 md:col-span-2 md:mb-0">{entry.org}</p>
          <div class="col-span-12 flex flex-col gap-6 md:col-span-5">
            <h2 class="title">{entry.title}</h2>
            <div class="flex max-w-[460px] flex-col gap-3.5 body-copy">
              {entry.summary.map((line) => <p>{line}</p>)}
            </div>
            <a class="link-row font-medium underline underline-offset-4" href={`/portfolio/${entry.slug}`}>View case study →</a>
          </div>
          <div
            role="img"
            aria-label={`${entry.title} cover placeholder`}
            class="col-span-12 mt-8 flex h-[260px] items-end bg-placeholder p-4 label !text-[#47443c] md:col-span-5 md:col-start-8 md:mt-0 md:h-[410px]"
          >
            [Cover image]
          </div>
        </article>
      ))}
    </section>

    <Footer />
  </main>
</Layout>
